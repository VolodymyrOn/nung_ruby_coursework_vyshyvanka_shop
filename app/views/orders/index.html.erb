<div class="mb-4">
  <h1 class="fw-bold">Мої замовлення</h1>
  <p class="text-secondary">Історія ваших покупок</p>
</div>

<% if @orders.any? %>

  <% @orders.each do |order| %>

    <div class="card border-0 shadow-sm mb-3">

      <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

          <div>
            <h5 class="fw-bold">
              Замовлення №<%= order.id %>
            </h5>

            <small class="text-secondary">
              Створено: <%= l(order.created_at, format: :long) %>
            </small>
          </div>

          <span class="badge <%= order.cancelled? ? 'bg-danger' : 'bg-primary' %> fs-6">
            <%= order_status_label(order.status) %>
          </span>

        </div>

        <hr>

        <div class="row">

          <div class="col-md-6">
            <p class="mb-1 text-secondary">Кількість позицій</p>
            <strong><%= order.order_items.sum(&:quantity) %></strong>
          </div>

          <div class="col-md-6">
            <p class="mb-1 text-secondary">Сума замовлення</p>

            <strong class="fs-5">
              <%= number_to_currency(order.total_amount,
                  unit: "₴", format: "%n %u", precision: 0) %>
            </strong>
          </div>

        </div>

        <div class="mt-3">
          <%= link_to "Детальніше",
              order_path(order),
              class: "btn btn-outline-dark btn-sm" %>
        </div>

      </div>

    </div>

  <% end %>

<% else %>

  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">

      <h5 class="fw-bold">Ви ще не маєте замовлень</h5>

      <p class="text-secondary">
        Перегляньте каталог і оберіть товари.
      </p>

      <%= link_to "До каталогу",
          products_path,
          class: "btn btn-dark" %>

    </div>
  </div>

<% end %>