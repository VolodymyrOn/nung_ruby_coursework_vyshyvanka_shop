<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">

        <h2 class="fw-bold text-center mb-4">
          Створення облікового запису
        </h2>

        <%= form_for(resource, as: resource_name,
                     url: registration_path(resource_name)) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :first_name, "Ім'я", class: "form-label" %>
            <%= f.text_field :first_name,
                class: "form-control",
                required: true,
                autocomplete: "given-name" %>
          </div>

          <div class="mb-3">
            <%= f.label :last_name, "Прізвище", class: "form-label" %>
            <%= f.text_field :last_name,
                class: "form-control",
                required: true,
                autocomplete: "family-name" %>
          </div>

          <div class="mb-3">
            <%= f.label :phone, "Номер телефону", class: "form-label" %>
            <%= f.telephone_field :phone,
                class: "form-control",
                autocomplete: "tel" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, "Електронна пошта", class: "form-label" %>
            <%= f.email_field :email,
                class: "form-control",
                required: true,
                autocomplete: "email" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, "Пароль", class: "form-label" %>

            <% if @minimum_password_length %>
              <small class="text-secondary">
                (мінімум <%= @minimum_password_length %> символів)
              </small>
            <% end %>

            <%= f.password_field :password,
                class: "form-control",
                required: true,
                autocomplete: "new-password" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation,
                "Підтвердження пароля",
                class: "form-label" %>

            <%= f.password_field :password_confirmation,
                class: "form-control",
                required: true,
                autocomplete: "new-password" %>
          </div>

          <%= f.submit "Зареєструватися",
              class: "btn btn-dark w-100" %>

        <% end %>

        <hr>

        <div class="text-center">
          <%= link_to "Вже маєте обліковий запис? Увійти",
              new_user_session_path,
              class: "text-decoration-none" %>
        </div>

      </div>
    </div>

  </div>
</div>