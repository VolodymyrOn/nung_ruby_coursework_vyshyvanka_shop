<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

  <div>
    <h1 class="fw-bold">Категорії товарів</h1>
    <p class="text-secondary mb-0">
      Управління категоріями каталогу
    </p>
  </div>

  <%= link_to "Додати категорію",
      new_admin_category_path,
      class: "btn btn-dark" %>

</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">

    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0">

        <thead class="table-light">
          <tr>
            <th class="ps-4">Назва</th>
            <th>Опис</th>
            <th>Кількість товарів</th>
            <th class="text-end pe-4">Дії</th>
          </tr>
        </thead>

        <tbody>

          <% @categories.each do |category| %>

            <tr>

              <td class="ps-4 fw-semibold">
                <%= category.name %>
              </td>

              <td>
                <%= category.description.presence || "—" %>
              </td>

              <td>
                <span class="badge bg-secondary">
                  <%= category.products.size %>
                </span>
              </td>

              <td class="text-end pe-4">

                <%= link_to "Редагувати",
                    edit_admin_category_path(category),
                    class: "btn btn-outline-dark btn-sm" %>

                <%= button_to "Видалити",
                    admin_category_path(category),
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm mt-1",
                    form: {
                      data: {
                        turbo_confirm: "Видалити цю категорію?"
                      }
                    } %>

              </td>

            </tr>

          <% end %>

          <% if @categories.empty? %>
            <tr>
              <td colspan="4" class="text-center text-secondary py-4">
                Категорій поки немає.
              </td>
            </tr>
          <% end %>

        </tbody>

      </table>

    </div>

  </div>
</div>