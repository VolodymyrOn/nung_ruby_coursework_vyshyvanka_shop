
<div class="container py-4">
  <div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Керування замовленнями</h1>
    <p class="text-muted mb-0">
      Перегляд та обробка замовлень клієнтів.
    </p>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: admin_orders_path, method: :get, local: true do |f| %>
        <div class="row g-3 align-items-end">
          <div class="col-md-6">
            <%= f.label :query, "Пошук замовлення",
                class: "form-label fw-semibold" %>

            <%= f.text_field :query,
                value: params[:query],
                class: "form-control",
                placeholder: "Номер, ім'я або email клієнта..." %>
          </div>

          <div class="col-md-4">
            <%= f.label :status, "Статус",
                class: "form-label fw-semibold" %>

            <%= f.select :status,
                options_for_select(
                  [["Усі статуси", ""]] +
                  Order::STATUSES.map { |status|
                    [order_status_label(status), status]
                  },
                  params[:status]
                ),
                {},
                class: "form-select" %>
          </div>

          <div class="col-md-2 d-flex gap-2">
            <%= f.submit "Фільтрувати",
                class: "btn btn-dark flex-grow-1" %>

            <%= link_to "Скинути", admin_orders_path,
                class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
      <strong>Список замовлень</strong>
      <span class="text-muted ms-2">
        <%= @orders.count %> записів
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3">№</th>
            <th>Клієнт</th>
            <th>Дата</th>
            <th>Кількість товарів</th>
            <th>Сума</th>
            <th>Статус</th>
            <th class="text-end pe-3">Дії</th>
          </tr>
        </thead>

        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td class="ps-3 fw-semibold">
                #<%= order.id %>
              </td>

              <td>
                <div class="fw-semibold">
                  <%= order.customer_name %>
                </div>
                <small class="text-muted">
                  <%= order.customer_email %>
                </small>
              </td>

              <td class="text-nowrap">
                <%= l(order.created_at, format: :short) %>
              </td>

              <td>
                <%= order.order_items.sum(&:quantity) %>
              </td>

              <td class="fw-semibold text-nowrap">
                <%= number_to_currency(order.total_amount,
                    unit: "₴", precision: 2, format: "%n %u") %>
              </td>

              <td>
                <% status_class = {
                  "pending" => "bg-warning-subtle text-warning-emphasis",
                  "confirmed" => "bg-info-subtle text-info-emphasis",
                  "shipped" => "bg-primary-subtle text-primary-emphasis",
                  "completed" => "bg-success-subtle text-success",
                  "cancelled" => "bg-secondary-subtle text-secondary"
                }.fetch(order.status, "bg-light text-dark") %>

                <span class="badge <%= status_class %>">
                  <%= order_status_label(order.status) %>
                </span>
              </td>

              <td class="text-end pe-3">
                <%= link_to admin_order_path(order),
                    class: "btn btn-sm btn-outline-primary" do %>
                  <i class="bi bi-eye me-1"></i>
                  Деталі
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @orders.empty? %>
            <tr>
              <td colspan="7" class="text-center text-muted py-5">
                Замовлень за вибраними параметрами не знайдено.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
