<div class="mb-4">
  <h1 class="fw-bold">Мій кошик</h1>
  <p class="text-secondary">Товари, які ви плануєте придбати</p>
</div>

<% if @cart_items.any? %>

  <div class="row g-4">

    <div class="col-lg-8">

      <% @cart_items.each do |item| %>

        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body">

            <div class="row align-items-center g-3">

              <div class="col-4 col-md-3">

                <% if item.product.images.attached? %>
                  <%= image_tag item.product.images.first,
                      class: "img-fluid rounded",
                      style: "width: 140px; height: 130px; object-fit: contain;" %>
                <% else %>
                  <div class="bg-light rounded d-flex align-items-center justify-content-center"
                       style="height: 130px;">
                    <span class="text-secondary">Фото</span>
                  </div>
                <% end %>

              </div>

              <div class="col-8 col-md-9">

                <div class="d-flex justify-content-between align-items-start">

                  <div>
                    <h5 class="fw-bold mb-1">
                      <%= item.product.title %>
                    </h5>

                    <p class="text-secondary small mb-1">
                      Розмір: <strong><%= item.size %></strong>
                    </p>

                    <p class="text-secondary small mb-2">
                      Ціна за одиницю:
                      <%= number_to_currency(item.product.price,
                          unit: "₴", format: "%n %u", precision: 0) %>
                    </p>
                  </div>

                  <%= button_to "Видалити",
                      cart_item_path(item),
                      method: :delete,
                      class: "btn btn-outline-danger btn-sm" %>

                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                  <%= form_with model: item,
                      url: cart_item_path(item),
                      method: :patch,
                      class: "d-flex gap-2 align-items-center" do |f| %>

                    <%= f.number_field :quantity,
                        min: 1,
                        max: 100,
                        class: "form-control",
                        style: "width: 85px;" %>

                    <%= f.submit "Оновити",
                        class: "btn btn-outline-dark btn-sm" %>

                  <% end %>

                  <strong class="fs-5">
                    <%= number_to_currency(item.product.price * item.quantity,
                        unit: "₴", format: "%n %u", precision: 0) %>
                  </strong>

                </div>

                <% unless item.product.is_active? %>
                  <div class="text-danger small mt-2">
                    Цей товар більше недоступний для покупки.
                  </div>
                <% end %>

              </div>

            </div>

          </div>
        </div>

      <% end %>

      <%= button_to "Очистити кошик",
          cart_path,
          method: :delete,
          class: "btn btn-outline-danger" %>

    </div>

    <div class="col-lg-4">

      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

          <h5 class="fw-bold mb-3">Підсумок замовлення</h5>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-secondary">Кількість товарів:</span>
            <strong><%= @cart.total_items %></strong>
          </div>

          <hr>

          <div class="d-flex justify-content-between mb-4">
            <span class="fw-semibold">Разом:</span>

            <strong class="fs-4">
              <%= number_to_currency(@cart.total_price,
                  unit: "₴", format: "%n %u", precision: 0) %>
            </strong>
          </div>

          <%= link_to "Оформити замовлення",
              new_order_path,
              class: "btn btn-dark btn-lg w-100" %>

          <%= link_to "Продовжити покупки",
              products_path,
              class: "btn btn-outline-secondary w-100 mt-2" %>

        </div>
      </div>

    </div>

  </div>

<% else %>

  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">

      <div class="fs-1 mb-3">🛒</div>

      <h4 class="fw-bold">Ваш кошик порожній</h4>

      <p class="text-secondary">
        Додайте товари з каталогу, щоб оформити замовлення.
      </p>

      <%= link_to "Перейти до каталогу",
          products_path,
          class: "btn btn-dark" %>

    </div>
  </div>

<% end %>