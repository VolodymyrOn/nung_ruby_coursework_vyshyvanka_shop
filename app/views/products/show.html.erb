<div class="mb-3">
  <%= link_to "← Повернутися до каталогу",
      products_path,
      class: "text-decoration-none text-secondary" %>
</div>

<div class="row g-4">

  <!-- Фотографії -->
  <div class="col-lg-6">

    <div class="card border-0 shadow-sm">
      <div class="card-body">

        <% if @product.images.attached? %>

          
<div class="product-gallery mb-4"
     data-controller="product-gallery">

  <% if @product.images.attached? %>
    <div class="position-relative bg-light rounded-4 overflow-hidden"
         style="height: 480px;">

      <% @product.images.each_with_index do |image, index| %>
        <div class="<%= index == 0 ? '' : 'd-none' %> position-absolute top-0 start-0 w-100 h-100"
             data-product-gallery-target="image">
          <%= image_tag image,
              class: "w-100 h-100",
              style: "object-fit: contain;" %>
        </div>
      <% end %>

      <% if @product.images.count > 1 %>
        <button type="button"
                class="btn btn-light rounded-circle shadow position-absolute top-50 start-0 translate-middle-y ms-3"
                style="width: 44px; height: 44px;"
                data-action="click->product-gallery#previous"
                aria-label="Попереднє фото">
          <i class="bi bi-chevron-left"></i>
        </button>

        <button type="button"
                class="btn btn-light rounded-circle shadow position-absolute top-50 end-0 translate-middle-y me-3"
                style="width: 44px; height: 44px;"
                data-action="click->product-gallery#next"
                aria-label="Наступне фото">
          <i class="bi bi-chevron-right"></i>
        </button>

        <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-3 px-3 py-2"
              data-product-gallery-target="counter">
          1 / <%= @product.images.count %>
        </span>
      <% end %>
    </div>

            <% if @product.images.count > 1 %>
              <div class="d-flex gap-2 mt-3 overflow-auto pb-2">
                <% @product.images.each_with_index do |image, index| %>
                  <button type="button"
                          class="btn p-1 border rounded-3 flex-shrink-0 <%= index == 0 ? 'active border-warning border-2' : '' %>"
                          style="width: 82px; height: 82px;"
                          data-product-gallery-target="thumbnail"
                          data-index="<%= index %>"
                          data-action="click->product-gallery#select"
                          aria-label="Перейти до фото <%= index + 1 %>"
                          aria-pressed="<%= index == 0 ? 'true' : 'false' %>">
                    <%= image_tag image,
                        class: "w-100 h-100 rounded-2",
                        style: "object-fit: cover;" %>
                  </button>
                <% end %>
              </div>
            <% end %>
                        
          <% else %>
            <div class="bg-light rounded-4 d-flex align-items-center justify-content-center"
                 style="height: 480px;">
              <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
            </div>
          <% end %>
        </div>


        <% else %>

          <div class="bg-light rounded d-flex align-items-center justify-content-center"
               style="height: 400px;">
            <div class="text-center text-secondary">
              <div class="fs-1">✿</div>
              <div>Фото товару поки відсутнє</div>
            </div>
          </div>

        <% end %>

      </div>
    </div>

  </div>

  <!-- Інформація -->
  <div class="col-lg-6">

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">

        <div class="text-secondary small mb-2">
          <%= @product.category.name %>
        </div>

        <h1 class="fw-bold mb-3">
          <%= @product.title %>
        </h1>

        <div class="fs-3 fw-bold text-dark mb-4">
          <%= number_to_currency(@product.price, unit: "₴", format: "%n %u", precision: 0) %>
        </div>

        <hr>

        <h5 class="fw-bold mb-3">Характеристики</h5>

        <table class="table">

          <tbody>

            <tr>
              <th>Для кого</th>
              <td><%= target_group_label(@product.target_group) %></td>
            </tr>

            <tr>
              <th>Матеріал</th>
              <td><%= fabric_label(@product.fabric) %></td>
            </tr>

            <tr>
              <th>Колір</th>
              <td><%= color_label(@product.color) %></td>
            </tr>

            <tr>
              <th>Техніка вишивки</th>
              <td><%= @product.technique %></td>
            </tr>

          </tbody>

        </table>

        <h5 class="fw-bold mt-4">Доступні розміри</h5>

        <div class="d-flex flex-wrap gap-2 mb-4">

          <% Product::SIZES.each do |size| %>

            <% stock = @product.stock_for(size) %>

            <span class="badge <%= stock.positive? ? 'bg-success' : 'bg-secondary' %> p-2">
              <%= size %> — <%= stock.positive? ? "Є в наявності" : "Немає" %>
            </span>

          <% end %>

        </div>

        <h5 class="fw-bold">Опис товару</h5>

        <p class="text-secondary">
          <%= simple_format(@product.description) %>
        </p>

        <% if user_signed_in? %>

          <% available_sizes = Product::SIZES.select do |size|
               @product.stock_for(size).positive?
             end %>
         
          <% if available_sizes.any? %>
         
            <%= form_with url: cart_items_path, method: :post do |f| %>
            
              <%= f.hidden_field :product_id, value: @product.id %>
            
              <div class="mb-3">
                <%= f.label :size, "Оберіть розмір",
                    class: "form-label fw-semibold" %>
                    
                <%= f.select :size,
                    available_sizes.map { |size| ["#{size} (#{@product.stock_for(size)} шт.)", size] },
                    {},
                    class: "form-select",
                    required: true %>
              </div>
                    
              <div class="mb-3">
                <%= f.label :quantity, "Кількість",
                    class: "form-label fw-semibold" %>
                    
                <%= f.number_field :quantity,
                    value: 1,
                    min: 1,
                    max: 100,
                    class: "form-control",
                    required: true %>
              </div>
                    
              <%= f.submit "Додати до кошика",
                  class: "btn btn-dark btn-lg w-100" %>
                
            <% end %>
                
          <% else %>
                
            <button class="btn btn-secondary btn-lg w-100 mt-3" disabled>
              Немає в наявності
            </button>
                
          <% end %>
                
        <% else %>
                
          <%= link_to "Увійдіть, щоб придбати товар",
              new_user_session_path,
              class: "btn btn-dark btn-lg w-100 mt-3" %>
            
        <% end %>

      </div>
    </div>

  </div>

</div>

<!-- Відгуки -->
<div class="mt-5" id="reviews">

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h3 class="fw-bold mb-1">Відгуки покупців</h3>
      <p class="text-secondary mb-0">
        <%= @reviews_count %> відгуків про цей товар
      </p>
    </div>

    <% if @average_rating %>
      <div class="text-end">
        <div class="fs-3 fw-bold">
          <%= @average_rating %> / 5
        </div>
        <div class="text-warning fs-5">
          <% 5.times do |i| %>
            <%= i < @average_rating.round ? "★" : "☆" %>
          <% end %>
        </div>
        <small class="text-secondary">Середня оцінка</small>
      </div>
    <% end %>
  </div>

  <% if user_signed_in? && @user_review.nil? %>
    <div class="card border-0 shadow-sm mb-4" id="review-form">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Залишити відгук</h5>

        <%= form_with model: [@product, Review.new] do |f| %>
          <div class="mb-3">
            <%= f.label :rating, "Ваша оцінка",
                class: "form-label fw-semibold" %>

            <%= f.select :rating,
                options_for_select([
                  ["5 — Відмінно", 5],
                  ["4 — Добре", 4],
                  ["3 — Задовільно", 3],
                  ["2 — Погано", 2],
                  ["1 — Дуже погано", 1]
                ], 5),
                {},
                class: "form-select",
                required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :body, "Ваш коментар",
                class: "form-label fw-semibold" %>

            <%= f.text_area :body,
                rows: 4,
                maxlength: 2000,
                class: "form-control",
                placeholder: "Поділіться враженнями про товар...",
                required: true %>
          </div>

          <%= f.submit "Опублікувати відгук",
              class: "btn btn-warning fw-semibold" %>
        <% end %>
      </div>
    </div>
  <% elsif user_signed_in? && @user_review.present? %>
    <div class="alert alert-info border-0">
      <i class="bi bi-info-circle me-2"></i>
      Ви вже залишили відгук на цей товар. Ви можете відредагувати або видалити його нижче.
    </div>
  <% else %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <p class="mb-2">Хочете поділитися враженнями про товар?</p>
        <%= link_to "Увійти, щоб залишити відгук",
            new_user_session_path,
            class: "btn btn-outline-dark" %>
      </div>
    </div>
  <% end %>

  <% if @reviews.any? %>
    <% @reviews.each do |review| %>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">

          <div class="d-flex flex-wrap justify-content-between gap-2">
            <div>
              <strong><%= review.user.full_name %></strong>
              <% if review.user_id == current_user&.id %>
                <span class="badge bg-warning text-dark ms-2">Ваш відгук</span>
              <% end %>
            </div>

            <span class="text-warning fs-5">
              <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
            </span>
          </div>

          <p class="mt-3 mb-2">
            <%= simple_format(review.body) %>
          </p>

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <small class="text-secondary">
              <%= l(review.created_at, format: :long) %>
            </small>

            <% if user_signed_in? && (review.user_id == current_user.id || current_user.admin?) %>
              <div class="d-flex gap-2">
                <% if review.user_id == current_user.id %>
                  <%= form_with model: [@product, review],
                      method: :patch,
                      class: "d-flex flex-wrap gap-2 align-items-center" do |f| %>

                    <%= f.select :rating,
                        options_for_select((1..5).map { |n| ["#{n} з 5", n] }, review.rating),
                        {},
                        class: "form-select form-select-sm",
                        style: "width: 110px;" %>

                    <%= f.text_field :body,
                        value: review.body,
                        maxlength: 2000,
                        required: true,
                        class: "form-control form-control-sm",
                        style: "width: 220px;",
                        aria: { label: "Текст відгуку" } %>

                    <%= f.submit "Зберегти",
                        class: "btn btn-sm btn-outline-primary" %>
                  <% end %>
                <% end %>

                <%= button_to product_review_path(@product, review),
                    method: :delete,
                    class: "btn btn-sm btn-outline-danger",
                    form: { class: "d-inline" },
                    data: { turbo_confirm: "Видалити цей відгук?" } do %>
                  <i class="bi bi-trash"></i>
                  Видалити
                <% end %>
              </div>
            <% end %>
          </div>

        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-5 bg-white rounded shadow-sm">
      <i class="bi bi-chat-square-text fs-1 text-secondary"></i>
      <p class="text-secondary mt-3 mb-0">
        Поки що відгуків немає. Будьте першим, хто поділиться враженнями!
      </p>
    </div>
  <% end %>

</div>